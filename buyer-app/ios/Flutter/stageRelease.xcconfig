#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release-stage.xcconfig"
#include "Generated.xcconfig"

ASSET_PREFIX=stage
BUNDLE_NAME=Hawkr Stage
BUNDLE_DISPLAY_NAME=Hawkr Stage
GOOGLESERVICE_INFO_PLIST=${PROJECT_DIR}/Runner/config/stage/GoogleService-Info.plist
// Google 登入的 reversed client ID（GOOGLE_REVERSED_CLIENT_ID），不進版控；範本見 config/Auth.example.xcconfig
#include? "../Runner/config/stage/Auth.xcconfig"

// Code signing — managed here, NOT pbxproj.
CODE_SIGN_IDENTITY = Apple Distribution
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = V2H73DN9FP
PROVISIONING_PROFILE_SPECIFIER = match AppStore io.github.will413028.hawkr.buyer.stage 1778984845
