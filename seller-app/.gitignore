# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
ios/build/derived_data

# Fastlane sensitive environment files
ios/fastlane/.env
android/fastlane/.env

# FVM Version Cache
.fvm/
# 忽略Codex Agent
.agents/
.claude/
# 本機驗證留下的截圖與腳本；沒忽略的話任何一次 git add -A 都會把它們提交進 repo
.claude-verify/
tools/
AGENTS.md
.release/secrets.local.yaml
dist/

# fastlane build artifacts
ios/fastlane/README.md
ios/fastlane/report.xml
ios/Runner.ipa
ios/Runner.app.dSYM.zip

# Build artifact — generated by "Setup Firebase Environment" build phase
# from ios/Runner/config/<flavor>/GoogleService-Info.plist
ios/Runner/GoogleService-Info.plist

# 賣家 App 只支援 iOS + Android，桌面 / Web 平台目錄是 Flutter SDK 自動 scaffold
# 出來的副產物，不需要追蹤（用到時跑 `flutter create --platforms=... .` 重建即可）
/linux/
/macos/
/windows/
# Only the isolated component catalog Web shell is tracked.
/web/*
!/web/index.html
!/web/flutter_bootstrap.js

# secrets — never commit backend env / service-account / signing material (security audit 2026-06-09)
/ev/
/.env
/.env.*
*firebase-adminsdk*.json
client_secret*.json
*.p8

# External service configuration (Firebase, Sentry, hosts) and per-flavor plists — never commit
/config/*.json
!/config/dart-defines.example.json
ios/Runner/config/
