--- a/dist/esm/server/app-render/cache-signal.js
+++ b/dist/esm/server/app-render/cache-signal.js
@@ -185,11 +185,20 @@ function scheduleImmediateAndTimeoutWithCleanup(callback, immediateTracker) {
     return ()=>{
         cancelled = true;
         unsubscribe == null ? void 0 : unsubscribe();
+        // workerd forbids touching I/O objects across requests: the module-loading
+        // CacheSignal is an isolate-wide singleton, so a timer scheduled by another
+        // request cannot be cleared here (IoContext error). A failed clear means the
+        // timer already died with its request; both call sites reset or reschedule
+        // pendingTimeoutCleanup right after, so ignoring is safe.
         if (immediate !== null) {
-            clearImmediate(immediate);
+            try {
+                clearImmediate(immediate);
+            } catch {}
         }
         if (timeout !== null) {
-            clearTimeout(timeout);
+            try {
+                clearTimeout(timeout);
+            } catch {}
         }
     };
 }
