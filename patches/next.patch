--- a/dist/esm/server/node-environment-extensions/fast-set-immediate.external.js
+++ b/dist/esm/server/node-environment-extensions/fast-set-immediate.external.js
@@ -34,6 +34,17 @@ function install() {
         globalThis.setImmediate = nodeTimers.setImmediate = // Workaround for missing __promisify__ which is not a real property
         patchedSetImmediate;
         globalThis.clearImmediate = nodeTimers.clearImmediate = patchedClearImmediate;
+        // Cross-request cleanup from the bundled CacheSignal copies can also land
+        // in clearTimeout (once their immediate has fired and armed the timeout) —
+        // same workerd IoContext restriction, same safe-to-ignore reasoning as
+        // patchedClearImmediate above.
+        const originalClearTimeout = globalThis.clearTimeout;
+        const patchedClearTimeout = (timeout)=>{
+            try {
+                return originalClearTimeout(timeout);
+            } catch {}
+        };
+        globalThis.clearTimeout = nodeTimers.clearTimeout = patchedClearTimeout;
         const nodeTimersPromises = require('node:timers/promises');
         nodeTimersPromises.setImmediate = patchedSetImmediatePromise;
         process.nextTick = patchedNextTick;
@@ -590,7 +601,16 @@ const patchedClearImmediate = (immediateObject)=>{
         ;
         immediateObject[Symbol.dispose]();
     } else {
-        originalClearImmediate(immediateObject);
+        // workerd (OpenNext/Cloudflare) forbids touching timers across requests:
+        // the module-loading CacheSignal singleton in the PRE-BUNDLED next-server
+        // runtimes (dist/compiled/next-server/*.runtime.prod.js) carries its own
+        // copy of scheduleImmediateAndTimeoutWithCleanup that the cache-signal.js
+        // hunks of this patch cannot reach, and its cross-request cleanup lands
+        // here through the global clearImmediate. A timer that cannot be cleared
+        // already died with its own request, so dropping the clear is safe.
+        try {
+            originalClearImmediate(immediateObject);
+        } catch {}
     }
 };
