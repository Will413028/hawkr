{
	"name": "hawkr-web",
	"version": "1.0.2",
	"description": "",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"fonts:check-build": "node scripts/fonts/check-build.mjs",
		"start": "next start",
		"start:standalone": "node .next/standalone/server.js",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"lint": "tsc --noEmit && biome check --max-diagnostics=200 app components features lib scripts tests middleware.ts next.config.ts open-next.config.ts postcss.config.mjs && tsx scripts/check-transport.ts && tsx scripts/check-no-emoji.ts && tsx scripts/check-theme-tokens.ts && tsx scripts/check-jsx-cjk-linebreak.ts && pnpm --filter @hawkr/ui-text check-enum-text ../../website",
		"architecture:check": "tsx scripts/check-architecture.ts",
		"gen:legal": "tsx scripts/generate-legal.ts",
		"gen:placeholders": "tsx scripts/gen-placeholders.ts",
		"transport:check": "tsx scripts/check-transport.ts",
		"dark-mode:check": "tsx scripts/check-dark-mode.ts",
		"analyze": "ANALYZE=true next build --webpack",
		"knip": "knip",
		"format": "biome format --write .",
		"test:unit": "node --experimental-test-module-mocks --import tsx --import ./tests/setup/hermetic.mjs --test tests/*.test.ts tests/*.test.mjs",
		"test:build-output": "node --import tsx --import ./tests/setup/hermetic.mjs --test tests/build-output/*.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:hermetic": "playwright test --grep-invert @live --retries=0",
		"test:e2e:live": "playwright test --grep @live",
		"test:e2e:contract": "playwright test --grep @contract",
		"test:e2e:ui": "playwright test --ui",
		"test:reliability": "playwright test tests/e2e/reliability.spec.ts",
		"build:seo": "NEXT_PUBLIC_FLAVOR=prod NEXT_PUBLIC_SEO_INDEXABLE=true NEXT_PUBLIC_HAWKR_AGENT_ENABLED=false NEXT_PUBLIC_WEB_ORIGIN=https://example.com NEXT_PUBLIC_ADM_ORIGIN=https://admin.example.com NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9/api/v1 API_BASE_URL=http://127.0.0.1:9/api/v1 next build",
		"test:seo": "playwright test --config=playwright.seo.config.ts",
		"lhci:desktop": "lhci autorun --config=lighthouserc.desktop.cjs",
		"lhci:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
		"storybook:build": "storybook build --output-dir output/storybook --disable-telemetry",
		"storybook:test": "vitest run --config vitest.storybook.config.ts",
		"design:check": "node scripts/check-cross-platform-tokens.mjs",
		"storybook:typecheck": "tsc --noEmit -p tsconfig.storybook.json",
		"storybook:apps": "node scripts/build-app-catalogs.mjs",
		"storybook:build:all": "pnpm storybook:apps && pnpm storybook:build",
		"storybook:mcp": "node scripts/storybook-mcp.mjs",
		"design:test": "node --test tests/check-cross-platform-tokens.test.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@ag-ui/core": "0.0.58",
		"@bufbuild/protobuf": "catalog:",
		"@clerk/nextjs": "7.9.7",
		"@connectrpc/connect": "catalog:",
		"@connectrpc/connect-query": "catalog:",
		"@connectrpc/connect-web": "catalog:",
		"@hawkr/api": "workspace:*",
		"@hawkr/icons": "workspace:*",
		"@hawkr/twaddr": "workspace:*",
		"@hawkr/ui-text": "workspace:*",
		"@editorjs/editorjs": "^2.31.6",
		"@editorjs/header": "^2.8.9",
		"@editorjs/image": "^2.10.3",
		"@editorjs/list": "^1.10.0",
		"@editorjs/table": "^2.4.5",
		"@editorjs/underline": "^1.2.1",
		"@heroui/react": "^3.0.5",
		"@heroui/styles": "^3.0.5",
		"@hookform/resolvers": "^5.4.0",
		"@sentry/nextjs": "^10.58.0",
		"@sentry/vercel-edge": "^10.58.0",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-query-devtools": "^5.101.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"clsx": "^2.1.1",
		"framer-motion": "^12.40.0",
		"gifenc": "1.0.3",
		"gifuct-js": "2.1.2",
		"gsap": "^3.15.0",
		"inapp-spy": "^5.0.10",
		"lenis": "^1.3.25",
		"maplibre-gl": "^6.4.1",
		"next": "catalog:",
		"next-intl": "catalog:",
		"next-themes": "^0.4.6",
		"nuqs": "^2.8.9",
		"postcss": "^8.5.23",
		"qrcode.react": "^4.2.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-easy-crop": "^6.1.0",
		"react-hook-form": "^7.79.0",
		"react-map-gl": "^8.1.2",
		"recharts": "3.9.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"three": "^0.185.1",
		"tw-animate-css": "1.4.0",
		"typescript": "catalog:",
		"vanta": "^0.5.24",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@lhci/cli": "^0.15.1",
		"@next/bundle-analyzer": "^16.3.6",
		"@next/env": "^16.3.6",
		"@opennextjs/cloudflare": "1.20.6",
		"@playwright/test": "~1.59.1",
		"@storybook/addon-a11y": "10.6.0",
		"@storybook/addon-docs": "10.6.0",
		"@storybook/addon-mcp": "10.6.0",
		"@storybook/addon-vitest": "10.6.0",
		"@storybook/nextjs-vite": "10.6.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.3",
		"@types/react-dom": "catalog:",
		"@types/three": "^0.185.1",
		"@vitest/browser-playwright": "4.1.8",
		"jsdom": "^30.0.1",
		"knip": "^6.15.0",
		"msw": "^2.14.6",
		"schema-dts": "^2.0.0",
		"storybook": "10.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.3",
		"typescript-compiler-api": "catalog:",
		"vite": "8.0.3",
		"vitest": "catalog:",
		"webpack": "^5.107.2",
		"wrangler": "4.125.0"
	}
}
