	"exceptions": [
		{
			"id": "type.sectionTitle",
			"type": "dimension",
			"classification": "unresolved-drift",
			"reason": "Buyer and seller use different section heading size under the same role.",
			"bindings": [
				{
					"source": "buyer.typography",
					"key": "AppTypography.sectionTitle",
					"property": "fontSize",
					"value": 18
				},
				{
					"source": "seller.typography",
					"key": "AppTypography.sectionTitle",
					"property": "fontSize",
					"value": 16
				}
			],
			"migration": "Compare dense seller forms and buyer sections at compact widths and large text before choosing a shared role or explicit density variant."
		},
		{
			"id": "type.appFamily",
			"type": "string",
			"classification": "platform-policy",
			"reason": "Buyer uses platform font inheritance; seller requests Roboto. Web body uses Roboto Latin plus system CJK, and brand headings use jf-openhuninn.",
			"bindings": [
				{
					"source": "buyer.typography",
					"key": "AppTypography.family",
					"value": "null"
				},
				{
					"source": "seller.typography",
					"key": "AppTypography.family",
					"value": "Roboto"
				}
			],
			"migration": "Preserve native CJK readability. Check actual glyph fallback and bundled fonts before changing font-family; shared size does not prove identical rendering."
		},
		{
			"id": "text.secondaryAlias",
			"type": "color",
			"classification": "accessibility-policy",
			"reason": "Seller source intentionally uses body ink for secondary text to preserve contrast; buyer uses muted ink. Both expose matching textMuted for the muted role.",
			"bindings": [
				{
					"source": "buyer.colors",
					"key": "AppColors.textSecondary",
					"value": "#5a6154"
				},
				{
					"source": "seller.colors",
					"key": "AppColors.textSecondary",
					"value": "#42493f"
				}
			],
			"migration": "Use explicit textPrimary/textMuted roles in new components. Review contrast and text size before changing the legacy textSecondary alias."
		},
		{
			"id": "social.favoriteActive",
			"type": "color",
			"classification": "unresolved-drift",
			"reason": "Web and apps distinguish likes from danger but use different reds.",
			"bindings": [
