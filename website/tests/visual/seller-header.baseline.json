{
	"desktop-1440__light": {
		"base": {
			"header": {
				"position": "relative",
				"display": "block",
				"width": "1440px",
				"height": "84px",
				"background-color": "rgba(0, 0, 0, 0)",
				"padding": "0px 44px"
			},
			"inner": {
				"display": "flex",
				"align-items": "center",
				"column-gap": "40px",
				"max-width": "1440px",
				"height": "84px",
				"min-height": "84px",
				"margin-left": "0px",
				"margin-right": "0px",
				"padding": "0px 56px",
				"background-color": "rgba(255, 253, 244, 0.78)",
				"border-top-width": "1px",
				"border-top-color": "rgba(255, 255, 255, 0.6)",
				"border-radius": "999px",
				"box-shadow": "rgba(255, 255, 255, 0.74) 0px 1px 0px 0px inset, rgba(31, 41, 51, 0.1) 0px 18px 46px 0px, rgba(50, 63, 75, 0.05) 0px 4px 14px 0px",
				"backdrop-filter": "none",
				"color": "rgb(66, 73, 63)"
			},
			"brand": {
				"display": "flex",
				"align-items": "center",
				"column-gap": "0px",
				"color": "rgb(25, 28, 24)",
				"text-decoration-line": "none"
			},
			"nav": {
				"display": "flex",
				"align-items": "center",
				"column-gap": "4px"
			},
			"navItemActive": {
				"position": "relative",
				"display": "flex",
				"align-items": "center",
				"justify-content": "center",
				"min-height": "44px",
				"padding": "0px 14px",
				"border-radius": "999px",
				"color": "rgb(184, 68, 31)",
				"font-size": "14px",
				"font-weight": "700",
				"text-decoration-line": "none",
				"white-space": "nowrap",
				"background-color": "rgba(184, 68, 31, 0.1)"
			},
			"navItemPlain": {
				"position": "relative",
				"display": "flex",
				"align-items": "center",
				"justify-content": "center",
				"min-height": "44px",
				"padding": "0px 14px",
				"border-radius": "999px",
				"color": "rgb(66, 73, 63)",
				"font-size": "14px",
				"font-weight": "700",
				"text-decoration-line": "none",
				"white-space": "nowrap",
				"background-color": "rgba(0, 0, 0, 0)"
			},
			"actions": {
				"display": "flex",
				"align-items": "center",
				"justify-content": "flex-end",
				"column-gap": "10px",
				"margin-left": "0px"
			},
			"cta": {
				"display": "flex",
				"align-items": "center",
				"column-gap": "8px",
				"height": "44px",
				"padding": "0px 18px",
				"border-radius": "999px",
				"background-color": "rgb(184, 68, 31)",
				"color": "rgb(255, 255, 255)",
				"font-size": "14px",
				"font-weight": "700",
				"text-decoration-line": "none",
				"white-space": "nowrap",
				"box-shadow": "rgba(31, 41, 51, 0.18) 0px 10px 22px 0px"
			},
			"iconBtn": {
				"display": "grid",
				"width": "44px",
				"height": "44px",
				"align-items": "center",
				"justify-items": "center",
				"border-top-width": "0px",
				"border-radius": "999px",
				"background-color": "rgba(0, 0, 0, 0)",
				"color": "rgb(66, 73, 63)"
			},
			"themeBtn": {
				"width": "44px",
				"height": "44px"
			},
			"avatar": {
				"display": "grid",
				"width": "44px",
				"height": "44px",
				"align-items": "center",
				"justify-items": "center",
				"border-top-width": "2px",
				"border-top-color": "rgba(154, 165, 177, 0.36)",
				"border-radius": "999px",
				"background-color": "rgb(245, 247, 250)",
				"color": "rgb(184, 68, 31)",
				"box-shadow": "rgba(255, 255, 255, 0.72) 0px 1px 0px 0px inset"
			}
		},
		"hover": {
			"navItem": {
				"backgroundColor": "rgba(184, 68, 31, 0.1)",
				"color": "rgb(184, 68, 31)",
				"transform": "matrix(1, 0, 0, 1, 0, -1)"
			},
			"cta": {
				"backgroundColor": "rgb(143, 51, 21)",
				"color": "rgb(255, 255, 255)",
				"transform": "matrix(1, 0, 0, 1, 0, -1)"
			},
			"iconBtn": {
				"backgroundColor": "rgba(184, 68, 31, 0.1)",
				"color": "rgb(184, 68, 31)",
				"transform": "matrix(1, 0, 0, 1, 0, -1)"
			}
		}
	},
