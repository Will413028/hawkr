# Hawkr Web environment
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Do not put real secrets in `.env.example`.

# Flavor / environment selector. dev | prod.
# `lib/config/env.ts` derives timeouts, logging flags and the dev-only defaults
# from this. Default `dev` so missing config never silently selects production.
# The production flavor has NO defaults for the API base, the web origin or the
# admin origin: leaving one unset fails the build/startup naming the variable.
NEXT_PUBLIC_FLAVOR=dev

# Top-level Hawkr Agent availability gate. This is baked into both server and
# browser bundles, so changing it requires a deployment. It is fail-closed:
# only the exact string true enables the feature. DEV and E2E set true
# explicitly; production sets false explicitly.
NEXT_PUBLIC_HAWKR_AGENT_ENABLED=true

# Backend API base URL — optional override (leave BOTH unset for the recommended default).
#
# Local dev DEFAULTS to a SAME-ORIGIN PROXY, mirroring prod's first-party-proxy
# topology: with these unset, `lib/config/env.ts` makes the browser call a relative
# /api/v1 → the app/api/v1/[...path] route forwards to the gateway server-side (the
# server/SSR base stays the absolute gateway). Same-origin means the session cookie
# lands on the web host (so the proxy.ts auth middleware sees it) and cookie-domain /
# VPN / content-blocker / self-signed-cert friction all disappear. Just leave both blank.
#
# Cross-origin browser calls to the backend are not supported: the backend sends no
# CORS headers, so the browser must use the same-origin proxy (do not point
# NEXT_PUBLIC_API_BASE_URL at the backend's own origin).
#
# API_BASE_URL overrides the server/SSR base (defaults to the absolute gateway).
API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=

# This deployment's own web origin: canonical URLs, sitemap, the CSRF same-origin
# check and the "is this the real site" host check all come from it. Only an
# origin (no path, query or credentials). dev falls back to
# http://localhost:3000 (what `pnpm dev` serves); prod requires it, e.g.
#   NEXT_PUBLIC_WEB_ORIGIN=https://www.example.com
NEXT_PUBLIC_WEB_ORIGIN=

# ADM（hawkr-admin）的 origin。
#
# 代行工作區（/adm，56 號）的「返回 ADM」與失效畫面要連回 ADM，而 ADM 與 www 從此
# 在兩個不同 host。dev 未設就用 http://localhost:3001；prod 必填，例如
#   NEXT_PUBLIC_ADM_ORIGIN=https://admin.example.com
# ⚠️ 不得由請求的 Host 推導：那讓任何能控制 Host 標頭的人指定管理員被送去哪裡。
NEXT_PUBLIC_ADM_ORIGIN=

# Image / media gateway origin (R2 + Cloudflare Worker): the only media host the
# app recognises as its own. Baked into the bundle at BUILD time by
# `readMediaBaseUrl` in lib/config/env.ts.
#
# Unset = no media origin: `buildImageUrl` builds no URL for a backend object key,
# so images are absent (it never falls back to another host). The Playwright
# suite asserts that images load, so `pnpm test:e2e` goes red without it. Set it
# for any local build/E2E:
NEXT_PUBLIC_MEDIA_BASE_URL=https://test-media.example.com

# LINE official account add-friend URL (absolute https URL), shown on the contact
# page. Baked into the bundle at BUILD time. Unset = no LINE entry is rendered.
NEXT_PUBLIC_LINE_URL=

# Where presigned uploads are PUT: comma-separated https origins (a host may start
# with one `*.` label, e.g. https://*.uploads.example.com). Read at BUILD time to
# build the CSP `connect-src`; unset = no upload origin in the policy.
MEDIA_UPLOAD_ORIGINS=

# === Firebase (僅供 phone OTP 註冊綁手機，不參與 OAuth) ===
# Get these from Firebase Console -> Project Settings -> Your apps -> Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Google OAuth (client-side, vendor-portal Google step-up) ===
# NEXT_PUBLIC_* vars are baked into the client bundle at build time.
# 顧客登入不經這個值（由後端 /api/auth/{provider}/start 處理）。
# Google: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# === Apple Pay domain association ===
# Apple Pay 網域驗證檔（/.well-known/apple-developer-merchantid-domain-association）
# 已改為靜態資料：見 lib/payment/applePayDomainAssociation.ts（依 flavor 提供），
# 不再走 env var / GitHub secret（值 5.6 kB 超過 Cloudflare Worker secret 上限）。

# Shared secret the Java order/product service sends in `x-revalidate-secret`
# when POSTing /api/revalidate to bust product:<id> / seller:<id> cache tags.
#   POST /api/revalidate   { "tags": ["product:<id>", "seller:<id>"] }
# Tag granularity (write-side contract):
#   - product:<id>  busts the PDP + that product's reviews.
#   - seller:<id>   busts the seller storefront profile + product grid + review stats.
# A single-product price/stock change should POST BOTH product:<id> AND the
# owning seller:<id> when the seller grid / home shelves must reflect it
# immediately (those surfaces render prices but are NOT covered by product:<id>);
# otherwise they refresh on their own cacheLife TTL.
REVALIDATE_SECRET=

# GA4 Measurement ID (G-XXXXXXX). Leave unset in dev/stage so no analytics
# events are sent. Prod build sets it → GA4 loads. For local QA, set it
# temporarily and watch GA4 DebugView.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === Sentry error monitoring (SaaS) ===
# DSN is NOT a secret — it ships in the client bundle. All Sentry init is gated
# on this var (sentry.{server,edge}.config.ts + instrumentation-client.ts), so
# leaving it unset disables Sentry entirely. Same DSN across all environments of one deployment;
# the `environment` tag is derived from NEXT_PUBLIC_APP_ENV / NODE_ENV.
NEXT_PUBLIC_SENTRY_DSN=
# Optional override for the Sentry `environment` tag. Normally unset — the tag
# derives from NEXT_PUBLIC_FLAVOR (prod/dev), then NODE_ENV. Set this only to
# force a custom environment name.
NEXT_PUBLIC_APP_ENV=
# Build-only secret for source map upload (readable prod stack traces).
# Sentry → Settings → Auth Tokens (scope: project:releases). Set in CI build env
# only — never commit. Build works without it (upload just skipped).
SENTRY_AUTH_TOKEN=
