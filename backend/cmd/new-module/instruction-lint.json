{
  "allowlist": {
    "entries": [
      {
        "expires": "2027-01-29",
        "path": "backend/internal/modules/accountsuspension/AGENTS.md",
        "reason": "多一節「鎖順序」，在七節固定形狀之外；歸位或移出由清理步驟決定",
        "rule": "R2"
      }
    ],
    "max_days": 90,
    "max_entries": 10,
    "warn_days": 14
  },
  "check_pins": {
    "files": [
      ".pre-commit-config.yaml",
      ".pre-commit-config.yml",
      "lefthook.yml",
      "lefthook.yaml",
      ".lefthook.yml",
      ".lefthook.yaml",
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml"
    ],
    "repo": "instruction-lint"
  },
  "discover": {
    "globs": [
      "AGENTS.md",
      "**/AGENTS.md"
    ]
  },
  "rules": {
    "C1": {
      "import_line": "@AGENTS.md",
      "level": "error",
      "mode": "forbid"
    },
    "R1": {
      "excluded_blocks": [
        {
          "begin": "<!-- BEGIN:nextjs-agent-rules -->",
          "end": "<!-- END:nextjs-agent-rules -->"
        }
      ],
      "level": "error",
      "max_bytes": {
        "nested": 6000,
        "root": 12000,
        "subproject": 10000
      },
      "max_line_chars": 500
    },
    "R2": {
      "level": "error",
      "shapes": [
        {
          "bullets_only": [],
          "glob": "backend/internal/modules/*/AGENTS.md",
          "heading_level": 2,
          "mode": "exact",
          "must_match": [],
          "purpose": false,
          "sections": [
            "職責",
            "擁有的資料",
            "發布的讀取介面",
            "模組內部結構",
            "不變量",
            "不負責",
            "決策紀錄"
          ],
          "title": true
        },
        {
          "bullets_only": [
            "不變量"
          ],
          "glob": "backend/internal/modules/*/internal/*/AGENTS.md",
          "heading_level": 2,
          "mode": "exact",
          "must_match": [],
          "purpose": true,
          "sections": [
            "不變量"
          ],
          "title": true
        }
      ]
    },
    "R3a": {
      "level": "error",
      "test_defs": [
        {
          "definition": "func (?:\\([^)]*\\)\\s*)?{name}\\(",
          "files": [
            "**/*_test.go"
          ],
          "name": "Test[A-Z0-9_][A-Za-z0-9_]*"
        },
        {
          "definition": "def {name}\\(",
          "files": [
            "**/test_*.py",
            "**/*_test.py"
          ],
          "name": "test_[A-Za-z0-9_]+"
        }
      ]
    },
    "R3b": {
      "base_dirs": [
        "backend",
        "website",
        "admin",
        "buyer-app",
        "seller-app",
        "packages/*",
        ".github/workflows"
      ],
      "check_bare_names": false,
      "file_extensions": [
        "md",
        "go",
        "py",
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "toml",
        "yaml",
        "yml",
        "sql",
        "sh",
        "dart",
        "proto",
        "css",
        "html",
        "txt"
      ],
      "ignore_negated_words": [
        "沒有",
        "尚無",
        "不存在",
        "已移除"
      ],
      "ignore_patterns": [
        "(^|/)node_modules(/|$)",
        "(^|/)\\.env(\\.|$)",
        "^\\.git(/|$)",
        "(^|/)\\.(next|vercel|venv|cache)(/|$)",
        "\\.gitkeep$"
      ],
      "level": "warn",
      "resolve_extensions": [
        ".ts",
        ".tsx"
      ],
      "source_roots": [
        "src"
      ]
    },
    "R3c": {
      "heading_pattern": "^#{1,6}[ \\t]+(?:§[ \\t]*)?(\\d+(?:\\.\\d+)*)(?![0-9])",
      "ignore_before": [
        "設計書\\s*$"
      ],
      "ignore_qualified": true,
      "level": "warn",
      "plain_words": [
        "see",
        "spec",
        "specification",
        "section",
        "sections",
        "in",
        "per",
        "and",
        "or",
        "to",
        "at",
        "of",
        "the",
        "also",
        "cf",
        "ref"
      ],
      "ref_pattern": "§\\s*(\\d+(?:\\.\\d+)*)",
      "specs": [
        {
          "glob": "backend/internal/modules/*/AGENTS.md",
          "spec": "backend/docs/modules/{1}.md"
        },
        {
          "glob": "backend/internal/modules/*/internal/*/AGENTS.md",
          "spec": "backend/docs/modules/{1}.md"
        }
      ]
    },
    "R4": {
      "date_patterns": [
        "(?<![0-9])(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?![0-9])"
      ],
      "ignore_token_patterns": [
        "/",
        "\\.(?:md|txt|sql|go|ts|tsx|js|py|toml|ya?ml|json)\\b",
        "(?:19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}-[A-Za-z]"
      ],
      "issue_patterns": [
        "(?<![A-Za-z0-9_&#/])#\\d+(?![A-Za-z0-9_])",
        "(?i:(?<![A-Za-z])(?:issue|pull request|PR)\\s+#?\\d+)(?![0-9])"
      ],
      "level": "error",
      "narrative_level": "warn",
      "narrative_words": [
        "currently",
        "recently",
        "previously",
        "formerly",
        "no longer",
        "used to",
        "for now",
        "at the moment",
        "temporarily",
        "newly",
        "目前",
        "最近",
        "近期",
        "暫時",
        "以前",
        "原本",
        "已改為",
        "已移除"
      ]
    },
    "R5": {
      "ignore_headings": true,
      "ignore_patterns": [],
      "level": "error",
      "min_chars": 40,
      "sibling_level": "warn"
    },
    "R6": {
      "candidate_patterns": [
        "`[A-Za-z_][A-Za-z0-9_.]*\\s*(?::=|=|:)\\s*-?\\d[0-9_.,]*[A-Za-z%]*`",
        "\\b[A-Z][A-Z0-9]*_[A-Z0-9_]+\\b[ \\t`=:]{1,6}[0-9]+",
        "(?<![A-Za-z0-9])\\d[0-9,_]*\\s?(?:ms|seconds?|minutes?|hours?|days?|bytes|KB|MB|GB|秒|分鐘|小時|天|字元)(?![A-Za-z])"
      ],
      "level": "warn"
    }
  }
}
