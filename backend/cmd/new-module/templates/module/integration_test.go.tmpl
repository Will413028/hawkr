//go:build integration

package {{.Name}}

import (
	"testing"

	"{{.Module}}/internal/platform/db"
	"{{.Module}}/internal/platform/migrate"
	"{{.Module}}/internal/platform/testdb"
)

var pg *testdb.Server

func TestMain(m *testing.M) { testdb.Main(m, &pg) }

// setup 給這支測試一個只套用了本模組 migration 的 database：integration 測試只跑在自己的 schema 上。排入 River
// job 的模組在前面加 testdb.Jobs()（見 content 模組）。獨立的測試開頭呼叫 t.Parallel()。
func setup(t *testing.T) *db.DB {
	t.Helper()
	return pg.NewDB(t, testdb.Migrations(migrate.Module{Name: "{{.Name}}", Dir: Migrations()}))
}
