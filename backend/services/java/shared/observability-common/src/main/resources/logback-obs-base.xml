<?xml version="1.0" encoding="UTF-8"?>
<!--
    Observability Common - Base Logback Configuration

    Usage: In your service's logback-spring.xml:

    <?xml version="1.0" encoding="UTF-8"?>
    <configuration>
        <include resource="logback-obs-base.xml"/>
    </configuration>

    Or with custom log level:

    <?xml version="1.0" encoding="UTF-8"?>
    <configuration>
        <include resource="logback-obs-base.xml"/>
        <logger name="io.github.will413028.hawkr" level="DEBUG"/>
    </configuration>
-->
<included>
    <!-- JSON Console Appender -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Field name mapping (ts, msg, etc.) -->
            <fieldNames>
                <timestamp>ts</timestamp>
                <message>msg</message>
                <logger>logger</logger>
                <thread>[ignore]</thread>
                <level>level</level>
                <stackTrace>stack_trace</stackTrace>
                <levelValue>[ignore]</levelValue>
                <version>[ignore]</version>
            </fieldNames>

            <!-- Timestamp format -->
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>

            <!-- Include all MDC fields -->
            <includeMdc>true</includeMdc>

            <!-- Exclude context from output -->
            <includeContext>false</includeContext>

            <!-- Exclude caller info (performance) -->
            <includeCaller>false</includeCaller>
        </encoder>
    </appender>

    <!-- Suppress noisy loggers -->
    <logger name="io.grpc.internal" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.opentelemetry" level="WARN"/>
    <logger name="org.springframework.amqp.rabbit" level="WARN"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON"/>
    </root>
</included>
