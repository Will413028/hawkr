{
  "annotations": {
    "list": []
  },
  "description": "Hawkr 電商平台系統總覽",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "🏥 服務健康狀態",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=~\"gateway|.*-service\"} or clamp_max(server_start_total, 1)",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }
      ],
      "description": "存活訊號在本系統有兩種傳輸，這個 panel 必須同時取：up（有 /metrics 可刮的服務——gateway 與 11 支 Java 服務）＋ clamp_max(server_start_total, 1)（gRPC-only 服務走 OTLP push，沒有 scrape target、因此永遠沒有 up series）。⚠️ 不要簡化成單一 up{...}：2026-09-10 之前就是這樣，11 支 Go 服務在本 panel 完全不存在，而 panel 不會報錯、只會少列。兩者語意有差：up 掛掉時是 0（列還在、變紅），OTLP 側掛掉時是整列消失（該情境由 service-alerts.yml 的 ProdOtlpServiceAbsent 以 absent() 承接）。",
      "title": "服務狀態",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "panels": [],
      "title": "📊 流量概覽",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])) by (job)",
          "legendFormat": "Java: {{ job }}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total[5m])) by (job)",
          "legendFormat": "Go: {{ job }}",
          "refId": "B"
        }
      ],
      "title": "請求速率 (QPS)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\",status=~\"5..\"}[5m])) by (job) / sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])) by (job)",
          "legendFormat": "Java: {{ job }}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (job) / sum(rate(http_requests_total[5m])) by (job)",
          "legendFormat": "Go: {{ job }}",
          "refId": "B"
        }
      ],
      "title": "錯誤率",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])) by (job, le))",
          "legendFormat": "Java P95: {{ job }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (job, le))",
          "legendFormat": "Go P95: {{ job }}",
          "refId": "B"
        }
      ],
      "title": "響應延遲 (P95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 7,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "JVM Heap: {{ job }}",
          "refId": "A"
        },
        {
          "expr": "go_memstats_alloc_bytes",
          "legendFormat": "Go: {{ job }}",
          "refId": "B"
        },
        {
          "expr": "process_resident_memory_bytes{job=~\".*service.*\"}",
          "legendFormat": "RSS: {{ job }}",
          "refId": "C"
        }
      ],
      "title": "記憶體使用",
      "type": "timeseries"
    },
