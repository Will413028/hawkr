# Hawkr 監控環境變數配置
# 複製此檔案為 .env 並填入實際值

# ===========================================
# 伺服器配置
# ===========================================
# 監控 VM
MONITORING_SERVER_IP=

# ===========================================
# Prometheus Targets（IP 設定）
# ===========================================
# Prometheus 改用 file_sd_configs，IP 不再寫在這裡
# 請執行 make init-targets 產生 target JSON，填入實際 IP
# 詳見 prometheus/targets/*.json.example

# ===========================================
# DB exporter DSN
# ===========================================
# 公司時期的 prod DB exporter 與它的 DSN（PROD_*_DSN）已刪除；本機堆疊沒有 DB exporter。
# 要監控資料庫時，在選定部署目標後再加（sql-exporter/sql_exporter.yml 保留，各 job 的 DSN 走
# ${VAR:?...} 環境變數注入）。

# ===========================================
# Grafana 配置
# ===========================================
GF_SERVER_ROOT_URL=http://your_grafana_ip:3000
# 注意：密碼不要使用 ! $ ` 等 shell 特殊字元，否則 Docker Compose 會解析錯誤
GF_SECURITY_ADMIN_USER=admin@example.com
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password

# ===========================================
# Discord 告警通知（必填）
# ===========================================
# 取得方式：Discord 伺服器設定 → 整合 → Webhook → 新增 Webhook → 複製 Webhook URL
# 預設頻道：infra 告警（ServiceDown / 磁碟 / CPU 等）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# 業務告警頻道 dev-警報 / prod-警報（channel=business，依 env 分流；選填，未設則不啟用該頻道）
# 用途：ATM 退款卡單（#1353）、假日資料覆蓋（#898）等業務正確性告警，與 infra 系統告警分頻道降低告警疲勞。
DISCORD_WEBHOOK_URL_DEV_ALERT=https://discord.com/api/webhooks/your_dev_alert_webhook
DISCORD_WEBHOOK_URL_PROD_ALERT=https://discord.com/api/webhooks/your_prod_alert_webhook
