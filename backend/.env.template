# ============================================
# 電子發票（光貿 AMEGO）— 58 號設計書 §12.1
# ============================================
# 取得方式：
#   1. AppKey / 統編：向光貿資訊（AMEGO）申請商用帳號時由對方核發，公開測試環境可用
#      統編 12345678 ＋ 光貿官網公告的測試 AppKey（見 58 號設計書 §4.5「AMEGO Provider 整合」）。
#      正式 App Key 的申請／輪替／撤銷流程是 §12.0 的阻斷項 P0-3，尚未定案。
#   2. 加密金鑰（INVOICE_ENCRYPTION_MASTER_KEY / INVOICE_LOOKUP_HMAC_KEY）：自行產生，
#      每環境各一把、dev 與 prod 絕不共用——共用的話，任何拿得到 dev secret 的人
#      就能解開 prod DB 裡的所有賣家 AppKey。
#        openssl rand -base64 32
#   3. 建 k8s Secret：填好本檔後跑 k8s/scripts/create-secrets.sh（8.8 段建 hawkr-amego）。
#      ⚠️ 略過一個 optional key 不等於保留叢集既有值：SSA 只保留本次送出的 key，
#         所以本檔必須是完整的。

# API 根位址。⚠️ 本行刻意留空而非預填 https://invoice-api.amego.tw：
# 預填會讓「照抄 template 的 prod .env」看起來已填好，重跑 create-secrets.sh 時把正確值
# 覆蓋掉。而 AMEGO 測試與正式**共用同一個網域且回應無環境標記** —— 覆蓋掉的後果不是
# 「連不上」（那看得見），而是在 prod 用測試統編靜默開出不進任何公司帳的發票。
AMEGO_BASE_URL=

# 平台自身 issuer 的 AppKey（唯一一把不在 DB 的；賣家的 AppKey 逐一加密存 DB）。
# 缺此 key＝平台自身 issuer（PLATFORM_RECEIPT 收據）開不了；賣家線不受影響。
AMEGO_PLATFORM_APP_KEY=your-amego-platform-app-key-here

# AppKey at-rest 加密金鑰（AES-256-GCM）。本機給一個明示 local-only 的固定值，
# 比照同檔 TOKEN_SECRET 的既有慣例：留空會讓 invoice-service 的
# Validate fail-closed（這是刻意的），本機開發時整個容器起不來。
# dev/prod 一律用 openssl rand -base64 32 各自產一把，不得沿用本行的值。
INVOICE_ENCRYPTION_MASTER_KEY=local-only-invoice-master-key-not-for-deploy
# 現行 key 版本號，寫進每列的 credential_key_version（smallint，值域 1~99999）。
# 沒有 INVOICE_ENCRYPTION_MASTER_KEY_ID 這個變數——字串標籤存不進 smallint。
INVOICE_ENCRYPTION_MASTER_KEY_VERSION=1
# 輪替期間的舊 key ＋ 其版本，兩者必須成對設定且版本不得等於 _VERSION。
# 非輪替期間留空是正常的；輪替期間缺此 key＝舊 key 加密的賣家憑證全部解不開，
# 該賣家開票立刻停止。
INVOICE_ENCRYPTION_MASTER_KEY_PREV=
INVOICE_ENCRYPTION_MASTER_KEY_PREV_VERSION=
# credential_fingerprint 的 HMAC-SHA256 key。**必須 ≠ master key**，否則指紋等於
# 用加密金鑰做的可預測推導。名字就是這個，沒有 INVOICE_CREDENTIAL_FINGERPRINT_KEY——
# 照那個名字建 secret ⇒ 群組裡多一個沒人讀的 key、服務要的那個不存在 ⇒ CrashLoop。
INVOICE_LOOKUP_HMAC_KEY=local-only-invoice-lookup-hmac-key-not-deploy

# egress-proxy 情境才填（§12.0 阻斷項 P0-1：光貿正式帳號是否啟用來源 IP 白名單，
# 書面確認回覆為「有」時才需要）。直連情境留空。
AMEGO_PROXY_CALLER_KEY_FILE=

# ============================================================
# Uber Direct（66 號設計書 §8.5）
# ============================================================
# 三者留空 ＝ Uber 尚未啟用，這是**合法的部署狀態**：
#   shipping-service 的 UberConfig 對憑證缺席 fail-closed（不帶空字串去打 API
#   ——那會變成一連串 401，而 401 對外看起來像我們被停權）；
#   payuni-webhook-service 的 verifier 零把金鑰 ⇒ 每一則 Uber webhook 都被拒。
#
# 🔴 UBER_CLIENT_ID 與 UBER_CLIENT_SECRET 必須**成對**：只有一半比兩個都沒有更糟
#    （UberConfig 會 log error 並全面 fail-closed，但那個錯誤要有人去看才會發現）。
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# 🔴 **一組不是一個**：JSON map {"<webhookId>": "<signing key>"}。
#    只放一把 ⇒ 多註冊一個 webhook 就靜默驗簽失敗 ⇒ 我方回 401
#    ⇒ Uber 不重試 4xx ⇒ 該 webhook 的事件全數遺失。
# 🔴 它是 per-webhook signing key，**不是** OAuth client_secret（API 總覽 §6.1）。
UBER_WEBHOOK_SIGNING_KEYS=
