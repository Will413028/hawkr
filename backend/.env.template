# ============================================
# Hawkr Local Development Environment
# ============================================
# Copy this file to .env and fill in the real values.
# cp .env.template .env

# 環境識別（prod / dev）
# 影響 OTel traces/logs 的 service.environment label 和 Promtail 的 environment label
APP_ENV=dev

# Infrastructure VM IP
INFRA_VM_IP=your-infra-vm-ip

# Database Configuration (PostgreSQL)
DB_HOST=${INFRA_VM_IP}
DB_PORT=5432
DB_USER=dbadmin
DB_PASSWORD=your-db-password
# 啟動時第一次連線的重試預算（秒）。未設定＝60。
# fx 的 pool constructor 會同步 Ping；失敗會讓建圖失敗、process 在 gRPC listener
# bind 之前就退出，任何 probe 都輪不到 ⇒ DB 抖一下就變成 CrashLoopBackOff。
# 在預算內退避重試可以把這個窗口交還給 startup probe。
# 上限受「k8s 何時殺掉容器」約束：有 startup probe ≈130s、沒有 ≈75s（liveness）。
# 設 0 關閉重試。詳見 pkg/database/postgres.go 的 DefaultPoolConfig。
DB_CONNECT_RETRY_BUDGET=60

# Redis Configuration
REDIS_HOST=${INFRA_VM_IP}
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# RabbitMQ Configuration
RABBITMQ_HOST=${INFRA_VM_IP}
RABBITMQ_PORT=5674
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USERNAME}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/%2F

# Dev Configs
NACOS_ENABLED=false
TRACING_ENABLED=true
MANAGEMENT_OTLP_TRACING_ENABLED=true
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# Firebase Configuration
# 取得方式：Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
# 留空 = 停用推播（notification-service 照常啟動，其他通道不受影響，不會去找 Application Default Credentials）。
# 啟用時填 service account 的整份 JSON（單行）。
FIREBASE_CREDENTIALS_JSON=

# 物件儲存後端（49 號設計書 §8.5）：r2（Cloudflare R2，現行儲存消費者 media / product-import）
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hawkr-media-dev
# OSS（阿里雲，退役中）：仍被尚未收斂的服務引用（§8.5 hawkr-oss 撒播收斂另案），
# 待 step 8 刪 OSS 前保留；儲存已切 R2，此組僅供非儲存消費者的環境變數解析。
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=your-oss-bucket-name
OSS_PRIVATE_BUCKET=your-oss-private-bucket-name

# PAYUNi Agent Configuration (Sandbox for testing)
# 取得方式：PAYUNi 後台 → API 資訊
PAYUNI_AGENT_ID=your-agent-id
PAYUNI_AGENT_KEY=your-payuni-agent-key
# 代理商 PayUni MerID (20 設計書 §4.13 和單 paymentMerId 決策)；留空時 CheckoutPreview consolidated=true 會被拒絕
PAYUNI_AGENT_MER_ID=
PAYUNI_AGENT_IV=your-payuni-agent-iv
PAYUNI_SANDBOX=true
# 測試環境的商店代號（create-secrets.sh:306 → hawkr-payuni secret）
PAYUNI_SANDBOX_MER_ID=
# PayUni API endpoint（Java 端唯一切換點：payment-service / shipping-service 的
# `payuni.base-url`）。由 k8s/scripts/create-secrets.sh 寫進 Secret `hawkr-payuni`。
#   dev / local：**留空**即可 —— 略過該 key，服務落回程式碼 default
#                （application.yml `${PAYUNI_API_URL:https://sandbox-api.payuni.com.tw}`）
#   prod       ：https://api.payuni.com.tw  ← **必須在此顯式填上，這是 prod 專屬的一行**
# ⚠️ 這是 #1798 的成因，也是建 prod 環境時最容易漏的一行：sandbox 與正式**共用同一組
#    PAYUNI_AGENT_KEY / PAYUNI_AGENT_IV，兩邊只差這個 endpoint**。漏設時金流「看起來
#    完全正常」（有回應、有交易號、不報錯），但真實付款全部打進 sandbox、永遠不會入帳，
#    而且 repo 與 pod 狀態都看不出異常 —— prod 曾三個服務同時如此，直到人工比對才發現。
#    診斷第三方付款失敗的第一步：`kubectl -n hawkr exec <pod> -- env | grep PAYUNI_API_URL`。
# ⚠️ 本行刻意留空而非預填 sandbox URL：預填會讓「照抄 template 的 prod .env」看起來已填好，
#    重跑 create-secrets.sh 時把正確的 prod endpoint 覆蓋成 sandbox（留空則略過、不覆蓋）。
# 注意 Go 端（seller-service，走 pkg/payuni）**不讀本值**，它用上面的 PAYUNI_SANDBOX 布林
# 選 sandbox/prod base URL。同一件事有兩個開關，切正式環境時兩個都要改。
PAYUNI_API_URL=
ENCRYPTION_KEY=your-32-char-encryption-key-here
ENCRYPTION_MASTER_KEY=your-base64-encoded-master-key
# Vendor Portal（#2539 E1）notification-service 專用：邀請信寄送（pkg/mail）。
# MAIL_PROVIDER=log 時不寄真信，只寫進 log；切 resend 才需要 RESEND_API_KEY。
MAIL_PROVIDER=log
MAIL_FROM=supports@example.com
RESEND_API_KEY=
# 收件人政策（pkg/mail/guard）：unrestricted／allowlist／redirect。
# ⛔ unrestricted 只有 ENV=prod 能用，其餘環境會被 config.Validate() 擋在啟動期。
# log provider 寄不到任何人，可留空；切 resend 就必填，缺值會啟動失敗。
# 本機要實際看信長什麼樣時：MAIL_PROVIDER=resend ＋ 這裡填 redirect ＋ 下面填你自己的信箱。
MAIL_RECIPIENT_POLICY=
MAIL_REDIRECT_TO=
# allowlist 模式才讀：逗號分隔，@ 開頭比對網域，其餘比對整串位址。
MAIL_ALLOWED_RECIPIENTS=@example.com,delivered@resend.dev
VENDOR_PORTAL_BASE_URL=http://localhost:3000

# Gateway Service Discovery
# VM 部署時改為對應 IP/hostname
# 舊服務呼叫 account-service、buyer-service、seller-service 的 gRPC（AccountService、DelegationService、BuyerService、SellerService）改由單體的 legacy listener 提供
# （LEGACY_GRPC_ADDR，本機是 host.docker.internal:9941）
ACCOUNT_SERVICE_HOST=host.docker.internal
BUYER_SERVICE_HOST=host.docker.internal
BUYER_SERVICE_GRPC_PORT=9941
SELLER_SERVICE_HOST=host.docker.internal
SELLER_SERVICE_GRPC_PORT=9941
PRODUCT_SERVICE_HOST=product-service
# category service（product-service 實作）的 gRPC port；
# ai-service 等內部 client 讀值用（issue #2786）。
PRODUCT_SERVICE_GRPC_PORT=9913
SOCIAL_SERVICE_HOST=social-service
SOCIAL_SERVICE_GRPC_PORT=9918
MEDIA_SERVICE_HOST=media-service
IM_SERVICE_HOST=im-service
IM_SERVICE_GRPC_PORT=9933
# Dedicated Gateway→IM ChatStream service-to-service JWT keys (>=32 random bytes;
# never reuse JWT_SECRET).
IM_CHAT_STREAM_JWT_SECRET=
IM_CHAT_STREAM_JWT_SECRET_PREV=
CART_SERVICE_HOST=cart-service
ORDER_SERVICE_HOST=order-service
PAYMENT_SERVICE_HOST=payment-service
AFTERSALES_SERVICE_HOST=aftersales-service
AFTERSALES_SERVICE_GRPC_PORT=9923
MARKETING_SERVICE_HOST=marketing-service
CRM_SERVICE_HOST=crm-service
REVIEW_SERVICE_HOST=review-service
REVIEW_SERVICE_GRPC_PORT=10033
# 必填，無預設：媒體公開網域（docker-compose-local.yml 缺值會拒絕啟動），例如 https://media.example.com
MEDIA_BASE_URL=
NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_GRPC_PORT=10037
# invoice-service（58 號設計書 §12.1.2 F）。三個 INVOICE_SERVICE_* 必須一起加：
# 漏 HOST/GRPC_PORT ⇒ 所有發票端點 503；漏 _FILE_PORT ⇒ 發票查得到但 PDF 下載不了。
INVOICE_SERVICE_HOST=invoice-service
INVOICE_SERVICE_GRPC_PORT=10041
INVOICE_SERVICE_FILE_PORT=10042
AI_SERVICE_HOST=ai-service
ORDER_SERVICE_GRPC_PORT=9915
# EXTERNAL lane 的訂單賣方 store（doc 64 §6.4.8）。⚠️ 必須是 seller-service 真的查得到的 store，不只是設定值。
PROCUREMENT_SETTLEMENT_STORE_ID=0
COUPON_SERVICE_HOST=coupon-service

# Gateway 對外 URL（PayUni return/redirect 用）
# 本地測試：http://127.0.0.1:9900 或 ngrok URL
GATEWAY_URL=http://127.0.0.1:9900

# Web 前端 base URL — payment / aftersales 在 client_type=WEB_BROWSER 時組 redirect_url 用（設計書 05 §5.9 / 09 §5.4.2）
# Dev 預設：http://localhost:3000
WEB_FRONTEND_URL=http://localhost:3000

# Web ISR 快取失效 webhook 的共享密鑰 — product / order / seller / product-import / review
# 五個服務呼叫網頁 `POST /api/revalidate` 時放在 `x-revalidate-secret` header
#（規範：開發規範/後端服務責任邊界規範 §9.4；行為：48 號設計書 §6.4）。
# 目標網域由 k8s values 的 WEB_REVALIDATE_BASE_URL 提供（那個值在 git 裡），只有本密鑰不在。
# **必須與同環境 hawkr-website 的 `.env` / `.env.dev` 同值**，否則網頁一律回 401。
# 由 k8s/scripts/create-secrets.sh 寫進 Secret `hawkr-common`；本值留空 = 略過該 key，
# 叢集既有值不被覆蓋（本地開發不跑 web ISR，留空即可）。
# ⚠️ values 裡它是 optional，缺這個 key 時 **pod 照樣 Running、log 只有一行 warn**，
#    但 backend revalidate 全面靜默停用：賣家/商品改動不會推倒網頁快取，得等 TTL 到期。
#    這種靜默失能比 CrashLoop 難發現，重建環境時最容易漏（#2024 就是它只活在叢集裡）。
#    產生方式：openssl rand -hex 32
WEB_REVALIDATE_SECRET=

# 來源簽章密鑰（#2264，01 設計書 §3.2.5）—— 自家 server 端呼叫者（網頁 Worker /
# CI）用 X-HK-Origin-Auth 宣告「我代表哪個限流身分」。
# 兩把刻意分開：暴露面不同的持有者不共用密鑰。持有 CI secret 的人若能簽 p=visitor，
# 就能帶任意受害者 IP 鎖死那個人的登入與 OTP 額度，而且 metric 記成 ok 不會告警。
# ⚠️ 留空 = **停用**該把密鑰的簽章驗證（請求落回 per-ClientIP，即本設計之前的行為），
#    不是啟動失敗、也不是「用空密鑰驗」。停用會由 gateway_origin_auth_enabled == 0
#    的 critical 告警現形。dev / prod 各要人工跑一次 create-secrets.sh 才會建立。
# 產生方式：openssl rand -hex 32
ORIGIN_AUTH_SECRET=
ORIGIN_AUTH_SECRET_PREV=
ORIGIN_AUTH_CI_SECRET=

# 本機文件檢視器（gateway 的 /docs，僅 APP_ENV=local/development）。三個值都沒有預設，
# 任一為空 = 停用：路由不註冊、請求回 404，gateway 照常啟動。
# DOCS_SIGN_KEY 是 session cookie 的 HMAC 金鑰，產生方式：openssl rand -hex 32
DOCS_USERNAME=
DOCS_PASSWORD=
DOCS_SIGN_KEY=

# CORS Origin Allowlist — 逗號分隔的精確來源（scheme+host+port），供 web cookie 認證使用。
# 只有列出的 Origin 才會取得 Access-Control-Allow-Origin / Allow-Credentials 回應頭。
# 未設定或空值 = 所有跨來源 web 請求被拒（native app 無 Origin 不受影響）。
CORS_ALLOWED_ORIGINS=

# Payment Service
# 信用卡付款完成導回
PAYUNI_RETURN_URL=hhttp://127.0.0.1:9900/payment/return

# AfterSales Service
# ATM 退款頁面完成導回（PayUni 填完銀行資訊後 Form POST 導回）
ATM_REFUND_RETURN_URL=hhttp://127.0.0.1:9900/atm-refund/return

# Shipping Service
# 門市地圖專用平台 MerID（Tag=2 僅回傳門市資訊，不建立物流單）
PAYUNI_STORE_MAP_MER_ID=HAWK9
# 選擇超商結果完成導回
PAYUNI_STORE_MAP_RETURN_URL=hhttp://127.0.0.1:9900/store_map/return

# Webhook URL for notifying PayUni about status updates:Prod 環境會由 Payuni 後台統一設定，測試環境才需要設定指向測試 API
PAYUNI_NOTIFY_URL=hhttp://127.0.0.1:9900/webhook/payuni/notify
PAYUNI_SHIPPING_NOTIFY_URL=hhttp://127.0.0.1:9900/webhook/payuni/notify


# JWT Secret（建議至少 32 字元隨機字串）
# 產生方式：openssl rand -hex 32
JWT_SECRET=your-jwt-secret-at-least-32-chars


# OpenTelemetry Collector（tracing / metrics）
# Go 服務（shared pkg/otel）使用 gRPC (4317)，Java 服務使用 HTTP (4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://${INFRA_VM_IP}:4317

# ── 內部服務間 HMAC 授權（52 號設計書，#1366）────────────────────────────
# create-secrets.sh:320-321 → hawkr-internal-auth secret。
# INTERNAL_AUTH_MODE=enforcing 時缺此值即 fail-closed ⇒ 所有服務間 gRPC 全部被拒。
# _PREV 是輪替期間的舊金鑰，第一次部署可留空。
INTERNAL_SERVICE_HMAC_SECRET=your-internal-hmac-secret
INTERNAL_SERVICE_HMAC_SECRET_PREV=
INTERNAL_AUTH_MODE=permissive

# ── Clerk（單體的登入；ADR docs/adr/2026-09-27-identity-clerk.md）───────────────
# 單體的 make serve、make worker 以 scripts/clerk-env.sh 讀這些變數（不經過 make 的指令列）。
# 填 development instance 的 key（pk_test_、sk_test_）；沒有填時只能用 make dev-token 簽的本機 token 登入。
# 顧客（買家、賣家）使用 Clerk；後台本機使用 make dev-token 的 dev key。
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk 設定時必填：dashboard 的 PEM public key（換行寫成 \n）。本機 make serve 的
# web origins 預設取 Makefile 的 CORS_ALLOWED_ORIGINS；部署時須明確設定允許的 origins。
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# ── GHCR image pull（拉私有 container image）──────────────────────────────
# create-secrets.sh:425-430。缺值時 pod 會停在 ImagePullBackOff。
# PAT 需 read:packages scope。
GHCR_USERNAME=your-github-username
GHCR_PAT=your-ghcr-pat

# TGOS 地址服務（內政部 TGOS QueryAddr）
# 🔴 缺這兩個 = seller-service **從第一次部署就起不來**：
#    k8s/scripts/create-secrets.sh:366-367 會來這裡取值建 hawkr-address secret，
#    而它的 get_env 缺值時回空字串**不報錯** ⇒ secret 建成空值 ⇒ 服務的
#    config.Validate() 把 4 個 TGOS 值列必填 ⇒ 啟動失敗。
#    整條鏈沒有任何一步會警告，只有 pod 進 CrashLoop 才看得到。
#    （另兩個 TGOS_BASE_URL／TGOS_PROXY_CALLER_KEY_FILE 由 k8s/values/seller-service.yaml
#     直接提供，不從這裡取；本地開發走 docker-compose-local.yml 的佔位值。）
# 取得方式：TGOS 平台申請（https://www.tgos.tw）→ 應用程式 ID 與 API Key
TGOS_QUERYADDR_APPID=your-tgos-appid
TGOS_QUERYADDR_APIKEY=your-tgos-apikey

# Gemini AI
# 取得方式：Google AI Studio → Get API Key
GEMINI_API_KEY=your-gemini-api-key

# ai-service slot extractor provider（gemini|deepseek|gemma，預設 gemini）
# 切到 deepseek/gemma 才需要對應的 API key
# 採購助手的模型。留空＝gemini-2.5-flash。
# 值域封閉在 services/ai-service/internal/llmprovider 的登記表（目前：
# gemini-2.5-flash / deepseek-flash / deepseek-v4-pro / google/gemma-4-26b-a4b-it:free）——
# 不是自由字串，因為模型名與 provider quirk 綁定。未列出的值會降級並告警。
# 取代了舊的 EXTRACTOR_PROVIDER 與 GEMMA_MODEL：模型名決定 provider，兩者不可能不一致。
# ⚠️ 舊的 EXTRACTOR_PROVIDER 已移除。若你的本機 .env 還留著它而沒設本項，
# 服務會 fail-closed 並在啟動 log 指出該改成什麼（刻意不做 alias：alias 會讓
# 舊名永遠有效，而放行的後果是靜默退回預設模型、打去另一家）。
EXTRACTOR_MODEL=

# ai-service：LLM 硬上限依賴的自訂治理預算（tokens／分鐘，非敏感、非 provider
# 配額，見 k8s/values/ai-service.yaml 同名 key 的完整說明）。本機留空即可——
# 未設定時 ai_procurement_llm_budget_limit 這支 gauge 刻意不 export（不是 export 0）。
LLM_TOKEN_BUDGET_PER_MINUTE=

# 品項解析 v2（retrieve-then-rank）旗標；預設關（未設或非 true 一律走 v1 階梯）。
# SHADOW_SAMPLE 是 v1 路徑順帶跑 v2 只記 log 的取樣百分比（0–100），只在 dev 設非零。

# Gateway 側的 run ledger capability flag（doc 57 §13）：true 時開放 GET
# /app/buyers/me/procurement/runs/:runId/events（run ledger 事件重播／即時訂閱
# SSE 端點）；預設 false，該端點固定回 503 CAPABILITY_UNAVAILABLE。
PROCUREMENT_REPLAY_SSE_ENABLED=false
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Maps API key（地址 geocode，seller-service 使用）
# 農業部開放資料 API Key（不帶 key 每日 1000 次，帶 key 每日 20000 次）
# 取得方式：https://data.moa.gov.tw 註冊帳號後取得
GOV_API_KEY_1=your-gov-api-key

# §5.19 物流貨態補收排程（L2 補救路徑）
SHIPPING_RECONCILE_ENABLED=true
SHIPPING_RECONCILE_INTERVAL_MS=600000
SHIPPING_RECONCILE_BATCH_SIZE=100
SHIPPING_RECONCILE_MAX_AGE_DAYS=7
SHIPPING_RECONCILE_BACKOFF_MINUTES=15
# §5.2.2 / §5.3.2 批次列印參數（超商批次共用 MAX_SIZE，宅配批次另用 HOME_LABEL_CONCURRENCY）
SHIPPING_BATCH_MAX_SIZE=50
SHIPPING_HOME_LABEL_CONCURRENCY=10
# §5.19.3.C 黑貓叫件 REQUESTED 卡死 ops 告警
SHIPPING_ALERT_TCAT_STUCK_ENABLED=true
SHIPPING_ALERT_TCAT_STUCK_INTERVAL_MS=600000
SHIPPING_ALERT_TCAT_STUCK_BATCH_SIZE=30
SHIPPING_ALERT_TCAT_STUCK_GRACE_MINUTES=3
SHIPPING_ALERT_TCAT_STUCK_MAX_AGE_HOURS=24
# §5.19.3.D 建店送審 REQUESTED 卡死 ops 告警
SHIPPING_ALERT_SUBMIT_STUCK_ENABLED=true
SHIPPING_ALERT_SUBMIT_STUCK_INTERVAL_MS=600000
SHIPPING_ALERT_SUBMIT_STUCK_BATCH_SIZE=20
SHIPPING_ALERT_SUBMIT_STUCK_GRACE_MINUTES=5
SHIPPING_ALERT_SUBMIT_STUCK_MAX_AGE_HOURS=24

# §2A.2 付款方式金額範圍改由 PaymentMethodLimitRules 硬編碼，不再用環境變數
# §2A.5 ATM 繳費期限（天）
PAYMENT_ATM_EXPIRE_DAYS=2

# Order Service — 付款期限與超時掃描（application.yml hawkr.order.*）
PAYMENT_DEADLINE_SECONDS=86400
# 64 號 §6.4.11：RFQ 成交建單的付款期限 = 建單 +12h，與結帳路徑刻意不同
RFQ_PAYMENT_DEADLINE_SECONDS=43200
CANCEL_SCAN_INTERVAL_MS=15000
# Order Service — 付款後建單保證：Outbox + Backstop（03 §8.10/§8.11）
ORDER_OUTBOX_PUBLISH_INTERVAL_MS=5000
# backend#3262 撥款閘門：無時間界 hold（售後進行中/申訴審理中/反查失敗）的重問間隔（秒）
ORDER_PAYOUT_HOLD_RECHECK_SECONDS=600
ORDER_SHIPMENT_BACKSTOP_ENABLED=true
ORDER_SHIPMENT_BACKSTOP_INTERVAL_MS=300000
ORDER_SHIPMENT_BACKSTOP_GRACE_MINUTES=30
