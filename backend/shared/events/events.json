{
  "version": "3.3.0",
  "description": "Hawkr 消息隊列事件定義 - 含 DLQ、延遲消息、Publisher Confirms、買賣家通知、訂單物流、評價邀請、結算通知",
  "features": {
    "publisher_confirms": true,
    "dead_letter_queue": true,
    "delayed_messages": true,
    "idempotency": true
  },
  "exchanges": {
    "hawkr.order": {
      "type": "topic",
      "durable": true,
      "description": "訂單相關事件交換機"
    },
    "hawkr.inventory": {
      "type": "topic",
      "durable": true,
      "description": "庫存相關事件交換機"
    }
  },
  "queues": {},
  "events": {
    "OrderCreatedEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.created",
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "ORDER_CREATED",
        "timestamp": "string (ISO8601)",
        "source": "string",
        "order_id": "int64",
        "user_id": "int64",
        "items": [
          {
            "sku_id": "int64",
            "quantity": "int32",
            "price": "decimal"
          }
        ],
        "total_amount": "decimal"
      }
    },
    "InventoryChangedEvent": {
      "exchange": "hawkr.inventory",
      "routing_key": "inventory.changed",
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "INVENTORY_CHANGED",
        "timestamp": "string (ISO8601)",
        "source": "string",
        "sku_id": "int64",
        "product_id": "int64",
        "old_stock": "int32",
        "new_stock": "int32",
        "change_type": "string (DEDUCT|RESTOCK|LOCK|UNLOCK)"
      }
    },
    "OrderStatusUpdatedEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.status.updated",
      "description": "訂單狀態更新事件 - 通用的狀態變更通知",
      "idempotency_key": "order_status:{order_id}:{new_status}:{timestamp}",
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "ORDER_STATUS_UPDATED",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "order_id": "int64",
        "order_no": "string",
        "user_id": "int64",
        "seller_id": "int64",
        "old_status": "string (PENDING_PAYMENT|PAID|PREPARING|SHIPPED|IN_TRANSIT|READY_FOR_PICKUP|DELIVERED|COMPLETED|CANCELLED|REFUNDING|REFUNDED)",
        "new_status": "string",
        "status_message": "string (optional)",
        "updated_at": "string (ISO8601)"
      }
    },
    "OrderShippedEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.shipped",
      "description": "訂單已出貨事件 - 賣家出貨時發送",
      "idempotency_key": "order_shipped:{order_id}:{tracking_number}",
      "priority": 5,
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "ORDER_SHIPPED",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "order_id": "int64",
        "order_no": "string",
        "user_id": "int64",
        "seller_id": "int64",
        "logistics_provider": "string (TCAT_HOME|HCT|SEVEN_ELEVEN|FAMILY_MART|HI_LIFE|OK_MART|SELF_PICKUP|OTHER)",
        "tracking_number": "string",
        "estimated_delivery": "string (ISO8601, optional)",
        "product_summary": "string (optional)",
        "shipped_at": "string (ISO8601)"
      }
    },
    "OrderDeliveredEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.delivered",
      "description": "訂單已送達事件",
      "idempotency_key": "order_delivered:{order_id}",
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "ORDER_DELIVERED",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "order_id": "int64",
        "order_no": "string",
        "user_id": "int64",
        "seller_id": "int64",
        "logistics_provider": "string",
        "tracking_number": "string",
        "receiver_name": "string (optional)",
        "delivered_at": "string (ISO8601)"
      }
    },
    "OrderPickupReadyEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.pickup.ready",
      "description": "超商取貨就緒事件 - 貨物已到達超商門市",
      "idempotency_key": "order_pickup:{order_id}",
      "priority": 5,
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "ORDER_PICKUP_READY",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "order_id": "int64",
        "order_no": "string",
        "user_id": "int64",
        "seller_id": "int64",
        "store_type": "string (SEVEN_ELEVEN|FAMILY_MART|HI_LIFE|OK_MART)",
        "store_name": "string",
        "store_address": "string",
        "pickup_deadline": "string (ISO8601)",
        "pickup_code": "string (optional)",
        "ready_at": "string (ISO8601)"
      }
    },
    "OrderCompletedEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.completed",
      "description": "訂單完成事件 - 買家確認收貨或自動完成",
      "idempotency_key": "order_completed:{order_id}",
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "ORDER_COMPLETED",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "order_id": "int64",
        "order_no": "string",
        "user_id": "int64",
        "seller_id": "int64",
        "amount": "decimal",
        "auto_completed": "boolean",
        "completed_at": "string (ISO8601)"
      }
    },
    "OrderCancelledEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.cancelled",
      "description": "訂單取消事件",
      "idempotency_key": "order_cancelled:{order_id}",
      "priority": 7,
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "ORDER_CANCELLED",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "order_id": "int64",
        "order_no": "string",
        "user_id": "int64",
        "seller_id": "int64",
        "amount": "decimal",
        "cancel_reason": "string",
        "cancelled_by": "string (BUYER|SELLER|SYSTEM)",
        "need_refund": "boolean",
        "cancelled_at": "string (ISO8601)"
      }
    },
    "PickupExpiryReminderEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.pickup.reminder",
      "description": "取貨到期提醒事件（延遲消息）- 提醒買家盡快取貨",
      "delayed": true,
      "idempotency_key": "pickup_reminder:{order_id}:{days_remaining}",
      "priority": 5,
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "PICKUP_EXPIRY_REMINDER",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "user_id": "int64",
        "order_id": "int64",
        "order_no": "string",
        "store_type": "string (SEVEN_ELEVEN|FAMILY_MART|HI_LIFE|OK_MART)",
        "store_name": "string",
        "store_address": "string",
        "pickup_deadline": "string (ISO8601)",
        "days_remaining": "int32 (3|1)",
        "pickup_code": "string (optional)",
        "product_summary": "string (optional)"
      }
    },
    "PickupReturnedEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.pickup.returned",
      "description": "取貨退回事件 - 買家未取貨，商品已退回賣家",
      "idempotency_key": "pickup_returned:{order_id}",
      "priority": 7,
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "PICKUP_RETURNED",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "user_id": "int64",
        "seller_id": "int64",
        "order_id": "int64",
        "order_no": "string",
        "store_type": "string (SEVEN_ELEVEN|FAMILY_MART|HI_LIFE|OK_MART)",
        "store_name": "string",
        "amount": "decimal",
        "return_reason": "string (EXPIRED|REJECTED)",
        "auto_refund": "boolean",
        "product_summary": "string (optional)",
        "returned_at": "string (ISO8601)"
      }
    },
    "ReviewInvitationEvent": {
      "exchange": "hawkr.order",
      "routing_key": "order.review.invitation",
      "description": "評價邀請事件 - 訂單完成後邀請買家評價",
      "idempotency_key": "review_invite:{order_id}",
      "fields": {
        "event_id": "string (UUID)",
        "event_type": "REVIEW_INVITATION",
        "timestamp": "string (ISO8601)",
        "source": "order-service",
        "user_id": "int64",
        "seller_id": "int64",
        "order_id": "int64",
        "order_no": "string",
        "products": [
          {
            "product_id": "int64",
            "product_name": "string",
            "product_image": "string (optional)",
            "quantity": "int32"
          }
        ],
        "seller_name": "string",
        "review_deadline": "string (ISO8601, optional)",
        "review_url": "string (optional)",
        "reward_points": "int32 (optional)"
      }
    }
  },
  "dlq_config": {
    "max_retry_count": 3,
    "retry_delay_ms": [
      1000,
      5000,
      30000
    ],
    "alert_on_max_retry": true,
    "alert_channels": [
      "log",
      "slack",
      "email"
    ]
  },
  "idempotency_config": {
    "key_prefix": "idempotent:mq:",
    "lock_timeout_secs": 30,
    "result_ttl_secs": 86400
  }
}
