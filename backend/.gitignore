# ===== Generated Proto Files =====
# Gateway 的 proto 生成檔案需要保留（因為使用本地模組路徑）
# 不再全域忽略 *.pb.go，改為在 services 目錄下忽略
services/**/*.pb.go
services/**/*_grpc.pb.go
# 但 shipping-service 的 proto 需要保留
!services/java/shipping-service/proto/**/*.pb.go
!services/java/shipping-service/proto/**/*_grpc.pb.go

