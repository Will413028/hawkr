{
	"name": "hawkr-admin",
	"private": true,
	"version": "1.0.0",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "tsc --noEmit && biome check . && pnpm --filter @hawkr/ui-text check-enum-text ../../admin",
		"format": "biome format --write .",
		"test": "node --import tsx --import ./tests/setup/env.mjs --test tests/*.test.ts",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
	},
	"dependencies": {
		"@bufbuild/protobuf": "catalog:",
		"@connectrpc/connect": "catalog:",
		"@connectrpc/connect-query": "catalog:",
		"@connectrpc/connect-web": "catalog:",
		"@hawkr/api": "workspace:*",
		"@hawkr/icons": "workspace:*",
		"@hawkr/twaddr": "workspace:*",
		"@hawkr/ui-text": "workspace:*",
		"@sentry/nextjs": "^10.61.0",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-query-devtools": "^5.104.0",
		"chart.js": "^4.4.1",
		"clsx": "^2.1.1",
		"fabric": "^7.4.0",
		"framer-motion": "^12.29.2",
		"konva": "^10.0.12",
		"next": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-konva": "^19.2.1",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@opennextjs/cloudflare": "^1.20.0",
		"@tailwindcss/postcss": "^4",
		"@types/fabric": "^5.3.10",
		"@types/jsdom": "^21.1.7",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"canvas": "^3.2.3",
		"jsdom": "^26.1.0",
		"tailwindcss": "^4",
		"tsx": "^4.22.4",
		"typescript": "catalog:",
		"typescript-compiler-api": "catalog:",
		"wrangler": "^4.105.0"
	}
