# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit it.
# 後端的入口（單體）：Connect 的方法與還沒搬的 REST（/api/v1，由單體轉給 gateway）都打這裡。
# 本機是 backend 的 make serve（預設聽 :8080）；沒設時也是這個值。
BACKEND_BASE_URL=http://localhost:8080
# 本機執行 backend 的 make dev-token args='-admin -user dev_ops'，把輸出設在此處。
# 部署時不設定 ADMIN_DEV_TOKEN；後台網域由 Cloudflare Access 保護。
ADMIN_DEV_TOKEN=
NEXT_PUBLIC_APP_ENV=dev
# 媒體 gateway 的 origin，也是 admin 唯一認得的自家媒體主機。缺這一項時 buildImageUrl
# 不會組出任何圖片網址（圖片不顯示，不會退到別的主機），本地驗證媒體相關頁面會看到
# 缺圖而誤判成修復失敗。
NEXT_PUBLIC_MEDIA_BASE_URL=https://test-media.example.com

# 56 號 ADM 代行營運：建立工作階段後 303 的兌換去向（website 的 origin）。
# 不得由請求的 Host 推導；缺這一項時 route 會擋下建立、不會導向 undefined。
# 值是該部署的網站 origin
WEB_ORIGIN=http://localhost:3000
